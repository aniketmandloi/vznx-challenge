# ====================================
# Database Configuration
# ====================================

# PostgreSQL connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?[options]
#
# Examples:
# - Local: postgresql://postgres:password@localhost:5432/vznx_challenge
# - Neon: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# - Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
#
DATABASE_URL=

# ====================================
# Authentication (Better-Auth)
# ====================================

# Secret key for signing tokens and sessions
# IMPORTANT: Must be at least 32 characters long
# Generate with: openssl rand -base64 32
#
BETTER_AUTH_SECRET=

# Base URL of your application
# Development: http://localhost:3001
# Production: https://your-domain.com
#
BETTER_AUTH_URL=

# ====================================
# CORS Configuration
# ====================================

# Allowed origins for CORS
# Should match BETTER_AUTH_URL
# Multiple origins: separate with commas
#
CORS_ORIGIN=

# ====================================
# Optional: Node Environment
# ====================================

# NODE_ENV=development
# NODE_ENV=production
